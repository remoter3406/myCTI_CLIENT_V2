<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>myCTI2</RootNamespace>
    <AssemblyName>myCTI</AssemblyName>
    <ApplicationIcon>Resources\myCTI.ico</ApplicationIcon>
    <LangVersion>latest</LangVersion>
    <!-- scharfe Darstellung bei Skalierung; Schrift wie unter .NET Framework, damit das Layout der Forms passt -->
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationDefaultFont>Microsoft Sans Serif, 8.25pt</ApplicationDefaultFont>
    <!-- einzige Quelle der Versionsnummer; Fenstertitel und Meldung an den Server werden daraus gebildet -->
    <Version>2.3.0</Version>
    <AssemblyTitle>myCTI</AssemblyTitle>
    <Product>myCTI</Product>
    <Copyright>Copyright © 2024</Copyright>
    <!-- Bilder/Icons in .resx auch mit "dotnet build" -->
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <!-- Testprojekt liegt im Unterordner und hat eigene Quellen -->
    <DefaultItemExcludes>$(DefaultItemExcludes);myCTI.Tests\**;packages\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Veröffentlichung als eine einzige Exe: Der Server setzt beim Download den Token
       (Properties\Resources.resx) direkt in die Exe ein, daher keine Kompression -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3240.44" />
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Testprojekt darf interne Helfer (TOOL) aufrufen -->
    <InternalsVisibleTo Include="myCTI.Tests" />
  </ItemGroup>

</Project>
